{
  "name": "courssy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:locales && next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "check:static": "npm run typecheck && npm run lint && npm run check:size && npm run check:complexity && npm run check:circular && npm run check:naming && npm run check:deps && npm run check:dead-exports",
    "check:repo": "npm run audit:courses-drift && npm run check:dod && npm run check:deploy-gate-shape && npm run check:hotspots && npm run check:migrations",
    "check": "npm run check:static && npm run test && npm run check:repo",
    "check:size": "npx tsx scripts/quality/check-file-size.ts",
    "check:complexity": "npx tsx scripts/quality/check-complexity.ts",
    "check:circular": "npx tsx scripts/quality/check-circular-deps.ts",
    "check:dead-exports": "npx tsx scripts/quality/check-dead-exports.ts",
    "check:migration": "bash scripts/ci/migration-test.sh",
    "check:migrations": "bash scripts/ci/check-destructive-migrations.sh",
    "check:e2e:sse": "playwright test --grep @sse --project=chromium --reporter=line",
    "check:hotspots": "npx tsx scripts/quality/hotspot-score.ts",
    "check:dod": "npx tsx scripts/quality/check-dod.ts",
    "check:deploy-gate-shape": "npx tsx scripts/quality/check-deploy-gate-shape.ts",
    "check:full": "npm run build && npm run check && npm run test:integration && npm run check:migration && npm run test:e2e && npm run check:e2e:sse",
    "check:messaging": "npx tsx scripts/diagnose-messaging-extended.ts",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "validate:locales": "npx tsx scripts/validate/validate-locales.ts",
    "audit:courses-drift": "npx tsx scripts/audit-courses-drift.ts",
    "generate:locales": "npx tsx scripts/generate/generate-locale-resolver.ts",
    "db:generate": "npx prisma generate",
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=default",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate && npx tsx scripts/generate/generate-locale-resolver.ts",
    "check:deps": "npx tsx scripts/quality/check-deps.ts",
    "check:naming": "npx tsx scripts/quality/forbid-deprecated-names.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/redis": "^1.38.0",
    "dompurify": "^3.4.11",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "openai": "^6.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.27.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
