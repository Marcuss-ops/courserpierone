{
  "name": "courser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run validate:locales && npm run generate:locales && next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint src/",
    "lint:eslint": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "validate:locales": "npx tsx scripts/validate/validate-locales.ts",
    "generate:locales": "npx tsx scripts/generate/generate-locale-resolver.ts",
    "db:generate": "npx prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate && npx tsx scripts/generate/generate-locale-resolver.ts"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@upstash/redis": "^1.38.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "nodemailer": "^7.0.13",
    "openai": "^6.39.1",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  }
}
