{
  "name": "courser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:locales && next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run audit:courses-drift && npm run lint && npm run test",
    "check:messaging": "npx tsx scripts/diagnose-messaging-extended.ts",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "validate:locales": "npx tsx scripts/validate/validate-locales.ts",
    "audit:courses-drift": "npx tsx scripts/audit-courses-drift.ts",
    "generate:locales": "npx tsx scripts/generate/generate-locale-resolver.ts",
    "db:generate": "npx prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate && npx tsx scripts/generate/generate-locale-resolver.ts"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "next-themes": "^0.4.6",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.15",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
