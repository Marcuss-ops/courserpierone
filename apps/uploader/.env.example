# ─────────────────────────────────────────────────────────────────
# TikShare — Environment Variables
# Copia questo file come .env nella cartella apps/uploader/
# ─────────────────────────────────────────────────────────────────

# TikTok API Credentials
# Registra l'app su https://developers.tiktok.com/
# Documentazione: https://developers.tiktok.com/doc/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# URL base dell'app (usato per il redirect URI OAuth)
# Per produzione su Vercel: https://uploader.courssy.com
# Per sviluppo locale: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000