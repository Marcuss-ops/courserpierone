# ─────────────────────────────────────────────────────────────
# Courser — Environment Variables
# Copia questo file come .env e compila i valori:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string per Prisma (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courser

# ─── Redis / Cache ───────────────────────────────────────────
# Due modalità di connessione (scegline una):
#
# A) Upstash REST (produzione) — serverless, HTTP-based
#    Ottieni le credenziali da: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
#
# B) Redis locale (sviluppo con docker-compose) — TCP diretto
#    docker compose up -d redis
#    Poi decommenta la riga sotto e commenta le due sopra:
# REDIS_URL=redis://localhost:6379
#
# Priorità: Upstash > REDIS_URL > fallback (nessuna cache)

# ─── Supabase Auth (Autenticazione) ─────────────────────────
# Login, registrazione e Google OAuth sono gestiti da Supabase Auth.
# Google OAuth credentials: configura in Authentication > Providers > Google
# nella dashboard Supabase (NON come env vars in Vercel). Client ID + Secret
# vivono solo nella dashboard Supabase del progetto.

# Project URL (pubblico) — da Project Settings > API
# Ottieni chiavi e URL da: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Email (SMTP) — TUTTI required, no defaults ────────────
# Usato per conferme acquisto e recupero checkout abbandonati.
# In sviluppo, se non configurato, i link vengono stampati nei log.
# Provider consigliato: Resend (https://resend.com). Anche SendGrid, Mailgun,
# Gmail SMTP funzionano — basta settare tutte le env sotto.
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=your-resend-api-key
EMAIL_FROM=Courssy <no-reply@your-domain.com>

# ─── Pagamenti ───────────────────────────────────────────────

# Lemon Squeezy (primario)
# API key: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your-lemon-squeezy-api-key
# Store ID: Settings > Stores
LEMONSQUEEZY_STORE_ID=your-lemon-store-id
# Webhook: Settings > Webhooks → https://your-domain.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemon-webhook-secret

# ─── Supabase (Storage & Admin) ──────────────────────────────
# SUPABASE_URL è anche usato come fallback per NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=https://your-project-ref.supabase.co

# ─── OpenAI (Traduzioni automatiche) ─────────────────────────
# Chiave da https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# ─── App Configuration ───────────────────────────────────────
# URL pubblico (usato per link nelle email, redirect post-checkout)
# Produzione: https://www.courssy.com
# Sviluppo:   http://localhost:3000
NEXT_PUBLIC_APP_URL=https://www.courssy.com
# Secret per proteggere endpoint cron
# Genera con: openssl rand -base64 32
CRON_SECRET=your-cron-secret-min-32-chars

# ─── Error Logging (production debug) ──────────────────────
# Secret per l'endpoint /api/log-error e per il sink server-side.
# Genera con: openssl rand -base64 32
# IMPORTANTE: lo stesso valore va messo in entrambe le variabili.
# - LOG_ERROR_SECRET: usato da /api/log-error per validare le richieste client
# - NEXT_PUBLIC_LOG_ERROR_SECRET: esposto al client, usato da useLogError()
#   per firmare le richieste (è un "soft gate" per evitare spam da script esterni;
#   la vera difesa è il rate limit + Redis lock)
# Se non impostato: il client hook è no-op e il sink server-side usa il fallback console.
LOG_ERROR_SECRET=your-error-log-secret-32-chars
NEXT_PUBLIC_LOG_ERROR_SECRET=your-error-log-secret-32-chars

# ─── Alert Webhook (production) ───────────────────────────
# Webhook URL per ricevere alert in tempo reale sugli errori server.
# Compatibile con Slack Incoming Webhooks e Discord webhooks.
# Se non impostato, gli errori vengono comunque salvati su Redis.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
