# ─────────────────────────────────────────────────────────────
# Courser — Environment Variables
# Copia questo file come .env e compila i valori:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string per Prisma (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courser

# ─── Redis / Cache (Upstash) ─────────────────────────────────
# Upstash Redis — usato per caching, rate limiting distribuito,
# e live presence (heartbeat utenti online).
# Se non configurato, l'app funziona in modalità degradata
# (cache disabilitata, rate limiting in-memory, presence disattivata).
# Ottieni le credenziali da: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Supabase Auth (Autenticazione) ─────────────────────────
# Login, registrazione e Google OAuth sono gestiti da Supabase Auth.
# Configura i provider OAuth in: Authentication > Providers nella dashboard Supabase.

# Project URL (pubblico) — da Project Settings > API
# Ottieni chiavi e URL da: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Google OAuth (configurato nella dashboard Supabase) ───
# Vai su: Authentication > Providers > Google
# Redirect URL: https://your-project-ref.supabase.co/auth/v1/callback

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (SMTP) ────────────────────────────────────────────
# Usato per conferme acquisto e recupero checkout abbandonati.
# In sviluppo, se non configurato, i link vengono stampati nei log.
# Provider: Resend, SendGrid, Mailgun, Gmail SMTP
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-user
EMAIL_SERVER_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@your-domain.com

# ─── Pagamenti ───────────────────────────────────────────────

# Stripe (legacy — usato come fallback)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable

# Lemon Squeezy (primario)
# API key: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your-lemon-squeezy-api-key
# Store ID: Settings > Stores
LEMONSQUEEZY_STORE_ID=your-lemon-store-id
# Webhook: Settings > Webhooks → https://your-domain.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemon-webhook-secret

# ─── Supabase (Storage & Admin) ──────────────────────────────
# SUPABASE_URL è anche usato come fallback per NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=https://your-project-ref.supabase.co

# ─── OpenAI (Traduzioni automatiche) ─────────────────────────
# Chiave da https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# ─── App Configuration ───────────────────────────────────────
# URL pubblico (usato per link nelle email, redirect post-checkout)
NEXT_PUBLIC_APP_URL=https://www.your-domain.com
# Secret per proteggere endpoint cron
# Genera con: openssl rand -base64 32
CRON_SECRET=your-cron-secret-min-32-chars
