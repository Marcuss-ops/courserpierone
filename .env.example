# ─────────────────────────────────────────────────────────────
# Courser — Environment Variables
# Copia questo file come .env e compila i valori:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string per Prisma (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courser

# ─── NextAuth (Autenticazione) ───────────────────────────────
# Genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret
# URL base dell'app (usato per callback OAuth)
NEXTAUTH_URL=https://www.courssy.com

# Google OAuth (opzionale)
# Abilita OAuth 2.0 su https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────────
# Usato per magic link, conferme acquisto, recupero checkout abbandonati.
# In sviluppo, se non configurato, i link vengono stampati nei log.
# Provider: Resend, SendGrid, Mailgun, Gmail SMTP
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@courser.app

# ─── Pagamenti ───────────────────────────────────────────────

# Stripe (legacy — usato come fallback)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Lemon Squeezy (primario)
# API key: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
# Store ID: Settings > Stores
LEMONSQUEEZY_STORE_ID=
# Webhook: Settings > Webhooks → https://tuodominio.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Supabase (Storage) ──────────────────────────────────────
# Usato per caricare copertine e asset dei corsi
SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── OpenAI (Traduzioni automatiche) ─────────────────────────
# Chiave da https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-

# ─── App Configuration ───────────────────────────────────────
# URL pubblico (usato per link nelle email, redirect post-checkout)
NEXT_PUBLIC_APP_URL=https://www.courssy.com
# Secret per proteggere endpoint cron (es. /api/cron/abandoned-checkouts)
CRON_SECRET=
