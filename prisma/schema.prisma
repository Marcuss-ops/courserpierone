generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ═══ Connection Pooling ═══════════════════════════════════
// DATABASE_URL = Pooled connection (pgBouncer, port 6543)
//   → usa ?pgbouncer=true&connection_limit=3 per serverless Vercel
// DIRECT_URL   = Direct connection (port 5432, solo per migrations)
//
// Supabase: prendi entrambi gli URL da Project Settings → Database

// ─── Prodotti (Libri / Corsi) ───────────────────────────────
// Phase 1.2 del piano DMs: ogni prodotto è associato a un creator
// (User.creatorId). Nullable in V1: tutti i prodotti esistenti
// verranno backfillati al creator primario nella migration di
// bootstrap (Fase 1.4). Le Permission della messaggistica
// (Fase 1.5) useranno questa FK per identificare il creator lato
// server senza hard-code.
model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  coverUrl         String? // URL immagine copertina PNG

  creatorId        String?  // Phase 1.2: owner del prodotto (User)
  creator          User?    @relation("CreatorProducts", fields: [creatorId], references: [id], onDelete: SetNull)

  templateId       String   @default("lumio") // lumio | h612 | horizon
  stripePriceId    String? // ID prezzo Stripe (legacy)
  lemonVariantId   String? // ID variante Lemon Squeezy
  lemonStoreId     String? // Store ID Lemon Squeezy (opzionale, per override)
  price            Int      @default(0) // in centesimi
  currency         String   @default("eur")
  status           String   @default("draft") // draft | published | archived
  pricesByCurrency String? // JSON: { "USD": { "price": 5500, "symbol": "$", "stripePriceId": "...", "lemonVariantId": "..." }, ... }
  countryOverrides String? // JSON: { "BR": { "currency": "BRL", "price": 9900, "symbol": "R$", "lemonVariantId": "123456" }, ... }
  defaultLanguage  String   @default("it") // Lingua default prodotto (per resume locale / content fallback)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations       ProductTranslation[]
  lessons            Lesson[]
  orders             Order[]
  abandonedCheckouts AbandonedCheckout[]
  conversations      Conversation[]

  // Phase 1.2: indice sulle query "tutti i prodotti del creator X"
  @@index([creatorId])
  // Compound index per inbox creator queries che filtrano pubblicati.
  // Query tipica: ``WHERE creatorId = X AND status = 'published'`` —
  // il compound permette un B-tree seek diretto invece di un filter
  // post-index-scan su creatorId. NOTA V2: il ``@@index([creatorId])``
  // singolo diventa ridondante (leftmost-prefix rule PG copre la parte
  // ``creatorId``); cleanup in un followup successivo per non
  // appesantire write-amplification con due indici sullo stesso campo.
  @@index([creatorId, status])
}

// ─── Traduzioni del Funnel (Problema, Storia, Recensioni, CTA) ─
model ProductTranslation {
  id        String @id @default(cuid())
  productId String
  locale    String // it, en, es, fr, de...
  section   String // problema | storia | recensioni | cta | titolo | sottotitolo
  content   String // Testo della sezione in quella lingua

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale, section])
}

// ─── Lezioni (video YouTube per lingua) ──────────────────────
model Lesson {
  id        String   @id @default(cuid())
  productId String
  position  Int // ordine lezione (1, 2, 3...)
  createdAt DateTime @default(now())

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations LessonTranslation[]
  progress     LessonProgress[]
  notes        LessonNote[]
  assets       LessonAsset[]

  @@index([productId])
}

model LessonTranslation {
  id          String  @id @default(cuid())
  lessonId    String
  locale      String
  title       String
  videoUrl    String? // URL YouTube "non in elenco" per quella lingua
  description String?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
}

// ─── Ordini / Pagamenti ─────────────────────────────────────
model Order {
  id                   String   @id @default(cuid())
  userId               String
  productId            String
  paymentProvider      String   @default("stripe") // stripe | lemonsqueezy
  stripeSessionId      String?  @unique // Stripe session ID (legacy)
  stripeSubscriptionId String?  // Stripe subscription ID (per targeted revoke)
  providerOrderId      String? // Order ID dal provider (Lemon Squeezy order ID)
  amount          Int // in centesimi
  currency        String
  locale          String? // lingua al momento dell'acquisto
  status          String   @default("pending") // pending | completed | failed | refunded
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([paymentProvider, providerOrderId])
  @@index([stripeSubscriptionId])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, productId, status])
}

// ─── Utenti ─────────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  role           String   @default("student") // admin | creator | student
  username       String?  @unique // URL pubblico: /u/username
  bio            String?  @db.Text // Bio pubblica Markdown
  socialLinks    String?  // JSON: { "twitter": "...", "instagram": "...", "youtube": "...", "linkedin": "...", "website": "..." }
  coverImageUrl  String?  // URL immagine copertina profilo
  lastSeenAt    DateTime? // ultima attività (WebSocket connect/disconnect)
  // User.preferredLocale: lingua preferita dell'utente per le email di
  // notifica (DM e altre). Backup-fillato al signup con il Accept-Language
  // del browser (vedi getServerUser.ts). Default 'en' per nuovi account
  // senza Accept-Language (es. retry/pagina di manutenzione). Mai null in
  // quanto @default valorizza sempre la colonna; il nullable è solo per
  // retrocompatibilità con row legacy pre-migration.
  preferredLocale String? @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  orders             Order[]
  accounts           Account[]
  sessions           Session[]
  sentMessages       Message[]        @relation("MessageSender")
  conversationsAsU1  Conversation[]   @relation("ConversationUserOne")
  conversationsAsU2  Conversation[]   @relation("ConversationUserTwo")

  // Phase 1.2: prodotti di cui l'utente è creator.
  createdProducts Product[] @relation("CreatorProducts")
}

// ─── NextAuth ───────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Progressi Lezioni ──────────────────────────────────────
model LessonProgress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastWatchedAt DateTime? // ultima visualizzazione lezione

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@index([lessonId])
}

// ─── Appunti Studenti ──────────────────────────────────────
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── Asset Scaricabili (PDF, audio, ecc.) ──────────────────
model LessonAsset {
  id        String   @id @default(cuid())
  lessonId  String
  type      String // pdf | audio | resource
  locale    String   @default("it") // lingua dell'asset
  fileUrl   String
  fileName  String?
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── Analytics Eventi ───────────────────────────────────────
model AnalyticEvent {
  id        String   @id @default(cuid())
  sessionId String? // ID unico del visitatore (cookie-based)
  productId String?
  eventType    String // pageview | scroll_deep | click_buy | checkout_open | checkout_complete | purchase | refund | checkout_abandoned | lesson_start | lesson_complete
  channelId    String? // YouTubeChannel.id (channel attribution)
  locale       String? // "it" | "en-us" | locale seen at event time
  revenueCents Int? // signed: +amount on purchase, -amount on refund
  metadata     String? // JSON string with extra data
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  visitor VisitorSession? @relation(fields: [sessionId], references: [id])

  @@index([eventType, createdAt])
  @@index([productId])
  @@index([sessionId])
}

// ─── Sessioni Visitatore (per funnel tracking) ──────────────
model VisitorSession {
  id          String   @id @default(cuid())
  ip          String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?
  country     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  events AnalyticEvent[]
}

// ─── Cache Config (per Vercel — evita scrittura su disco) ───
model CourseConfigCache {
  id        String   @id @default(cuid())
  slug      String   @unique
  config    String // JSON string del CourseConfig completo
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Coupon / Sconti ────────────────────────────────────────
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // es. "ESTATE2026"
  type        String    @default("percent") // percent | fixed
  value       Int       // percentuale (es. 20) o importo in centesimi (es. 1000)
  minAmount   Int?      // importo minimo ordine in centesimi
  maxUses     Int?      // numero massimo di utilizzi
  usedCount   Int       @default(0)
  productId   String?   // null = applicabile a tutti i prodotti
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Tabella Locale: codici lingua-paese completi ─────────
model Locale {
  id             String   @id @default(cuid())
  code           String   @unique // "fr-fr", "pt-br", "en-us"...
  languageCode   String // "fr", "pt", "en"...
  countryCode    String? // "FR", "BR", "US"... (null per lingue senza paese es. "en")
  name           String // "French (France)"
  nativeName     String // "Français (France)"
  isActive       Boolean  @default(true)
  fallbackLocale String? // "en-us" — catena di fallback
  currency       String? // "EUR", "USD", "BRL"...
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  youtubeChannels YouTubeChannel[]
}

// ─── Regole paese → locale preferito ──────────────────────────
model CountryLocaleRule {
  id                 String   @id @default(cuid())
  countryCode        String   @unique // "FR", "DE", "BR"...
  preferredLocale    String   // "fr-fr"
  alternativeLocales String?  // JSON array: ["en-us", "de-de"]
  createdAt          DateTime @default(now())
}

// ─── Canali YouTube localizzati ───────────────────────────────
model YouTubeChannel {
  id                 String   @id @default(cuid())
  channelName        String
  channelUrl         String   @unique
  localeId           String
  locale             String // denormalizzato per query veloci: "fr-fr"
  languageCode       String // "fr"
  countryCode        String?
  niche              String?
  defaultLandingSlug String? // slug prodotto predefinito
  trackingCode       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  localeRef Locale @relation(fields: [localeId], references: [id])
}

// ─── Checkout abbandonati (per email di recupero) ─────────
model AbandonedCheckout {
  id              String    @id @default(cuid())
  email           String
  productId       String
  locale          String    @default("it")
  paymentProvider String // stripe | lemonsqueezy
  checkoutUrl     String? // URL del checkout esterno
  status          String    @default("pending") // pending | recovered | expired
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([email])
}

// ─── Traduzioni Landing Pages (DB condiviso per tutti i siti) ─
// Una tabella unica per memorizzare le traduzioni di TUTTE le landing page
// in TUTTE le lingue. Ogni sito/slug ha il suo set di traduzioni.
model LandingTranslation {
  id              String   @id @default(cuid())
  slug            String // chiave della landing (es. "amish-secrets")
  locale          String // it, en, fr, es, de, pt, ja, zh...
  // Testi della landing page
  heroTitle       String?
  heroSubtitle    String?
  heroDescription String?
  problemText     String?
  storyText       String?
  ctaText         String?
  // Sezioni strutturate (JSON)
  benefits        String? // JSON array di { title, desc }
  testimonials    String? // JSON array di { text, author }
  faq             String? // JSON array di { q, a }
  // Bonus
  bonusLabel      String?
  guaranteeText   String?
  // Metadati
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([slug, locale])
}

// ─── Conversations (una stanza per coppia + prodotto) ────────
// Phase 1.3 del piano DMs: ogni coppia (creator, cliente) ha una
// conversazione distinta per ciascun prodotto acquistato.
//   • Mario + creator: una chat per "Corso A", una per "Corso B"
//   • Il campo productId è obbligatorio: viene garantito a monte
//     dal permission resolver (Fase 1.5) e da Order conpleted.
//
// ⚠️ FK CASCADE su productId:
//   Se un Product viene eliminato, TUTTE le Conversation (e i Message
//   associati via Cascade) di quel prodotto vengono cancellati.
//   Scelta consapevole per V1: una conversazione "orfana" di prodotto
//   non ha più significato nel modello creator↔cliente↔prodotto.
//   Per "soft archive" futuro del prodotto preservando la chat,
//   valutare di migrare a ON DELETE RESTRICT + logic di archiviazione.
model Conversation {
  id        String   @id @default(cuid())
  userOneId String   // uno dei due partecipanti
  userTwoId String   // l'altro partecipante
  productId String   // prodotto che contestualizza questa DM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOne  User      @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userOneId, userTwoId, productId])
  @@index([userOneId, updatedAt])
  @@index([userTwoId, updatedAt])
  @@index([productId, updatedAt])
}

// ─── Webhook Idempotency ──────────────────────────────────
// Previene ordini duplicati quando Stripe/LemonSqueezy
// inviano lo stesso webhook più di una volta.
model ProcessedWebhook {
  id         String   @id @default(cuid())
  provider   String   // stripe | lemonsqueezy
  deliveryId String   @unique // Stripe event.id | LS composite ID
  eventType  String   // checkout.session.completed, order_created, etc.
  processedAt DateTime @default(now())
  createdAt  DateTime  @default(now())
}

// ─── Direct Messages tra studente e creator ────────────────
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String   // chi ha inviato QUESTO messaggio
  content        String   @db.Text
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
