generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Prodotti (Libri / Corsi) ───────────────────────────────
model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  coverUrl         String? // URL immagine copertina PNG
  templateId       String   @default("lumio") // lumio | h612 | horizon
  stripePriceId    String? // ID prezzo Stripe (legacy)
  lemonVariantId   String? // ID variante Lemon Squeezy
  lemonStoreId     String? // Store ID Lemon Squeezy (opzionale, per override)
  price            Int      @default(0) // in centesimi
  currency         String   @default("eur")
  status           String   @default("draft") // draft | published | archived
  pricesByCurrency String? // JSON: { "USD": { "price": 5500, "symbol": "$", "stripePriceId": "...", "lemonVariantId": "..." }, ... }
  countryOverrides String? // JSON: { "BR": { "currency": "BRL", "price": 9900, "symbol": "R$", "lemonVariantId": "123456" }, ... }
  defaultLanguage  String   @default("it") // Lingua default prodotto (per resume locale / content fallback)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations       ProductTranslation[]
  lessons            Lesson[]
  orders             Order[]
  abandonedCheckouts AbandonedCheckout[]
}

// ─── Traduzioni del Funnel (Problema, Storia, Recensioni, CTA) ─
model ProductTranslation {
  id        String @id @default(cuid())
  productId String
  locale    String // it, en, es, fr, de...
  section   String // problema | storia | recensioni | cta | titolo | sottotitolo
  content   String // Testo della sezione in quella lingua

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale, section])
}

// ─── Lezioni (video YouTube per lingua) ──────────────────────
model Lesson {
  id        String   @id @default(cuid())
  productId String
  position  Int // ordine lezione (1, 2, 3...)
  createdAt DateTime @default(now())

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations LessonTranslation[]
  progress     LessonProgress[]
  notes        LessonNote[]
  assets       LessonAsset[]
}

model LessonTranslation {
  id          String  @id @default(cuid())
  lessonId    String
  locale      String
  title       String
  videoUrl    String? // URL YouTube "non in elenco" per quella lingua
  description String?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
}

// ─── Ordini / Pagamenti ─────────────────────────────────────
model Order {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  paymentProvider String   @default("stripe") // stripe | lemonsqueezy
  stripeSessionId String?  @unique // Stripe session ID (legacy)
  providerOrderId String? // Order ID dal provider (Lemon Squeezy order ID)
  amount          Int // in centesimi
  currency        String
  locale          String? // lingua al momento dell'acquisto
  status          String   @default("pending") // pending | completed | refunded
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([paymentProvider, providerOrderId])
  @@index([createdAt])
  @@index([userId])
}

// ─── Utenti ─────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      String   @default("student") // admin | student
  createdAt DateTime @default(now())

  orders   Order[]
  accounts Account[]
  sessions Session[]
}

// ─── NextAuth ───────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Progressi Lezioni ──────────────────────────────────────
model LessonProgress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastWatchedAt DateTime? // ultima visualizzazione lezione

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

// ─── Appunti Studenti ──────────────────────────────────────
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── Asset Scaricabili (PDF, audio, ecc.) ──────────────────
model LessonAsset {
  id        String   @id @default(cuid())
  lessonId  String
  type      String // pdf | audio | resource
  locale    String   @default("it") // lingua dell'asset
  fileUrl   String
  fileName  String?
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── Analytics Eventi ───────────────────────────────────────
model AnalyticEvent {
  id        String   @id @default(cuid())
  sessionId String? // ID unico del visitatore (cookie-based)
  productId String?
  eventType String // pageview | scroll_deep | click_buy | checkout_open | checkout_complete | purchase | lesson_start | lesson_complete
  metadata  String? // JSON string with extra data
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  visitor VisitorSession? @relation(fields: [sessionId], references: [id])

  @@index([eventType, createdAt])
  @@index([productId])
}

// ─── Sessioni Visitatore (per funnel tracking) ──────────────
model VisitorSession {
  id          String   @id @default(cuid())
  ip          String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?
  country     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  events AnalyticEvent[]
}

// ─── Cache Config (per Vercel — evita scrittura su disco) ───
model CourseConfigCache {
  id        String   @id @default(cuid())
  slug      String   @unique
  config    String // JSON string del CourseConfig completo
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Coupon / Sconti ────────────────────────────────────────
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // es. "ESTATE2026"
  type        String    @default("percent") // percent | fixed
  value       Int       // percentuale (es. 20) o importo in centesimi (es. 1000)
  minAmount   Int?      // importo minimo ordine in centesimi
  maxUses     Int?      // numero massimo di utilizzi
  usedCount   Int       @default(0)
  productId   String?   // null = applicabile a tutti i prodotti
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Tabella Locale: codici lingua-paese completi ─────────
model Locale {
  id             String   @id @default(cuid())
  code           String   @unique // "fr-fr", "pt-br", "en-us"...
  languageCode   String // "fr", "pt", "en"...
  countryCode    String? // "FR", "BR", "US"... (null per lingue senza paese es. "en")
  name           String // "French (France)"
  nativeName     String // "Français (France)"
  isActive       Boolean  @default(true)
  fallbackLocale String? // "en-us" — catena di fallback
  currency       String? // "EUR", "USD", "BRL"...
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  youtubeChannels YouTubeChannel[]
}

// ─── Regole paese → locale preferito ──────────────────────────
model CountryLocaleRule {
  id                 String   @id @default(cuid())
  countryCode        String   @unique // "FR", "DE", "BR"...
  preferredLocale    String   // "fr-fr"
  alternativeLocales String?  // JSON array: ["en-us", "de-de"]
  createdAt          DateTime @default(now())
}

// ─── Canali YouTube localizzati ───────────────────────────────
model YouTubeChannel {
  id                 String   @id @default(cuid())
  channelName        String
  channelUrl         String   @unique
  localeId           String
  locale             String // denormalizzato per query veloci: "fr-fr"
  languageCode       String // "fr"
  countryCode        String?
  niche              String?
  defaultLandingSlug String? // slug prodotto predefinito
  trackingCode       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  localeRef Locale @relation(fields: [localeId], references: [id])
}

// ─── Checkout abbandonati (per email di recupero) ─────────
model AbandonedCheckout {
  id              String    @id @default(cuid())
  email           String
  productId       String
  locale          String    @default("it")
  paymentProvider String // stripe | lemonsqueezy
  checkoutUrl     String? // URL del checkout esterno
  status          String    @default("pending") // pending | recovered | expired
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([email])
}

// ─── Traduzioni Landing Pages (DB condiviso per tutti i siti) ─
// Una tabella unica per memorizzare le traduzioni di TUTTE le landing page
// in TUTTE le lingue. Ogni sito/slug ha il suo set di traduzioni.
model LandingTranslation {
  id              String   @id @default(cuid())
  slug            String // chiave della landing (es. "amish-secrets")
  locale          String // it, en, fr, es, de, pt, ja, zh...
  // Testi della landing page
  heroTitle       String?
  heroSubtitle    String?
  heroDescription String?
  problemText     String?
  storyText       String?
  ctaText         String?
  // Sezioni strutturate (JSON)
  benefits        String? // JSON array di { title, desc }
  testimonials    String? // JSON array di { text, author }
  faq             String? // JSON array di { q, a }
  // Bonus
  bonusLabel      String?
  guaranteeText   String?
  // Metadati
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([slug, locale])
}
