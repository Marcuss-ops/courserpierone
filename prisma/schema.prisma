generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Runtime: pooled Supabase URL. Pool params: docs/production-hardening.md Appendix B.3.
// Migrations: Prisma migrate uses DIRECT_URL (non-pooled session connection).

// ─── Prodotti (Libri / Corsi) ───────────────────────────────
// Phase 1.2 del piano DMs: ogni prodotto è associato a un creator
// (User.creatorId). Post-fase 4 hardening `creatorId` è REQUIRED e
// la FK è `ON DELETE RESTRICT` — il fallback al "primo admin" in
// resolve-message-permission è stato rimosso insieme al deny-reason
// `no_creator_for_product`. La migration
// `20260712210000_creator_id_required_restrict` enforcia l'invariant a
// livello DB (ALTER COLUMN SET NOT NULL + DROP/ADD CONSTRAINT).
//
// Le Permission della messaggistica (Fase 1.5) usano direttamente
// questa FK per identificare il creator lato server senza hard-code.
model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  coverUrl         String? // URL immagine copertina PNG

  creatorId        String   // Owner del prodotto (User) — REQUIRED post-fase 4 hardening.
  creator          User     @relation("CreatorProducts", fields: [creatorId], references: [id], onDelete: Restrict)

  templateId       String   @default("lumio") // lumio | h612 | horizon
  lemonVariantId   String? // ID variante Lemon Squeezy
  lemonStoreId     String? // Store ID Lemon Squeezy (opzionale, per override)
  price            Int      @default(0) // in centesimi
  currency         String   @default("eur")
  status           String   @default("draft") // draft | published | archived
  pricesByCurrency String? // JSON: { "USD": { "price": 5500, "symbol": "$", "lemonVariantId": "..." }, ... }
  countryOverrides String? // JSON: { "BR": { "currency": "BRL", "price": 9900, "symbol": "R$", "lemonVariantId": "123456" }, ... }
  defaultLanguage  String   @default("it") // Lingua default prodotto (per resume locale / content fallback)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations       ProductTranslation[]
  lessons            Lesson[]
  orders             Order[]
  abandonedCheckouts AbandonedCheckout[]
  conversations      Conversation[]
  communityPosts     CommunityPost[]

  // MCR Phase 2: back-pointer su AccessGrant. La relazione viene
  // usata dal provider di resolver AccessGrant e da eventuali future
  // query "tutti i grant attivi su questo prodotto".
  accessGrants    AccessGrant[]      @relation("ProductAccessGrants")

  // Phase 4: Offer Cards created for this product (upsell target).
  offerCards      OfferCard[]

  // Compound index per inbox creator queries che filtrano pubblicati.
  // Query tipica: ``WHERE creatorId = X AND status = 'published'`` —
  // il compound permette un B-tree seek diretto invece di un filter
  // post-index-scan su creatorId. Il ``@@index([creatorId])`` singolo
  // era ridondante (leftmost-prefix rule PG copre la parte
  // ``creatorId``) ed è stato rimosso: il compound è sufficiente.
  @@index([creatorId, status])
}

// ─── Traduzioni del Funnel (Problema, Storia, Recensioni, CTA) ─
model ProductTranslation {
  id        String @id @default(cuid())
  productId String
  locale    String // it, en, es, fr, de...
  section   String // problema | storia | recensioni | cta | titolo | sottotitolo
  content   String // Testo della sezione in quella lingua

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale, section])
}

// ─── Lezioni (video YouTube per lingua) ──────────────────────
model Lesson {
  id        String   @id @default(cuid())
  productId String
  position  Int // ordine lezione (1, 2, 3...)
  createdAt DateTime @default(now())

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations LessonTranslation[]
  progress     LessonProgress[]
  notes        LessonNote[]
  assets       LessonAsset[]

  @@index([productId])
}

model LessonTranslation {
  id          String  @id @default(cuid())
  lessonId    String
  locale      String
  title       String
  videoUrl    String? // URL YouTube "non in elenco" per quella lingua
  description String?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
}

// ─── Ordini / Pagamenti ─────────────────────────────────────
model Order {
  id                   String   @id @default(cuid())
  userId               String
  productId            String
  paymentProvider      String   @default("lemonsqueezy") // lemonsqueezy
  providerOrderId      String? // Order ID dal provider (Lemon Squeezy order ID)
  amount          Int // in centesimi
  currency        String
  locale          String? // lingua al momento dell'acquisto
  status          String   @default("pending") // pending | completed | failed | refunded
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([paymentProvider, providerOrderId])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, productId, status])
}

// ─── Utenti ─────────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  role           String   @default("student") // admin | creator | student
  username       String?  @unique // URL pubblico: /u/username
  bio            String?  @db.Text // Bio pubblica Markdown
  socialLinks    String?  // JSON: { "twitter": "...", "instagram": "...", "youtube": "...", "linkedin": "...", "website": "..." }
  coverImageUrl  String?  // URL immagine copertina profilo
  lastSeenAt    DateTime? // ultima attività (WebSocket connect/disconnect)
  // User.preferredLocale: lingua preferita dell'utente per le email di
  // notifica (DM e altre). Backup-fillato al signup con il Accept-Language
  // del browser (vedi getServerUser.ts). Default 'en' per nuovi account
  // senza Accept-Language (es. retry/pagina di manutenzione). Mai null in
  // quanto @default valorizza sempre la colonna; il nullable è solo per
  // retrocompatibilità con row legacy pre-migration.
  preferredLocale String? @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  orders             Order[]
  sentMessages       Message[]        @relation("MessageSender")
  conversationsAsU1  Conversation[]   @relation("ConversationUserOne")
  conversationsAsU2  Conversation[]   @relation("ConversationUserTwo")

  // Phase 1.2: prodotti di cui l'utente è creator.
  createdProducts Product[] @relation("CreatorProducts")
  lessonProgresses    LessonProgress[]

  // Community feed (2026-07-15) — posts the user has authored in course
  // community feeds. ON DELETE RESTRICT matches the AccessGrant pattern:
  // deleting a user must not silently drop their posted resources.
  communityPosts CommunityPost[] @relation("CommunityPostAuthor")

  // MCR Phase 2: access grants unificano acquisti, free enrollment,
  // admin grant, bundle inclusion. Il back-pointer `accessGrants`
  // permette query `WHERE userId = X AND status='active'` per il
  // resolver `resolve-product-access` (PR 3 of MCR).
  accessGrants    AccessGrant[]      @relation("UserAccessGrants")

  // Phase 4: Offer Cards sent/received by this user.
  offerCardsSent     OfferCard[] @relation("OfferCardCreator")
  offerCardsReceived OfferCard[] @relation("OfferCardRecipient")

  // Centro Notifiche (Bell feature): ogni utente può ricevere
  // notifiche in-app (compaiono nella campanella in CourseTopNav) e
  // può avere preferenze di delivery per categoria. CASCADE su entrambi
  // — cancellare un utente elimina le sue notifiche/preferenze.
  notifications          Notification[]
  notificationPreference NotificationPreference?
}

// ─── Community Feed (2026-07-15) — Skool-style creator posts ──────────
// Per-product feed where the creator posts resources (links, PDFs, videos,
// notes) for enrolled students. Read-only MVP — admin CRUD UI deferred.
// Schema mirrors the lessons table pattern (per-product, ordered by
// createdAt) with one extra `pinned` flag for the sticky "welcome" post.
//
// `type` ∈ { "note", "link", "pdf", "video" } — validated application-side
// in src/lib/community/post-types.ts. Not a Prisma enum so future types
// (audio, image, poll) can be added without a migration.
//
// `url` is the attachment/link target. For type="note" it's null.
// ON DELETE RESTRICT on author (matches AccessGrant): deleting the creator
// must not silently drop their posted resources — require explicit cleanup.
model CommunityPost {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  title     String
  body      String?  @db.Text
  type      String   @default("note")
  url       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  // Compound index for the canonical feed query:
  //   WHERE productId = X ORDER BY pinned DESC, createdAt DESC
  @@index([productId, pinned, createdAt])
}

// ─── Centro Notifiche (Skool-style Bell) ─────────────────────────────
// Modello unico per TUTTE le tipologie di notifica in-app. `type` non è
// un enum Prisma (perché futuri tipi devono aggiungersi senza migration):
// viene validato lato application in src/lib/notifications/create-notification.ts.
// `entityId` è un riferimento polimorfico (string) — non FK — perché
// l'entità può essere Message/Lesson/Product/SystemAdmin announcement.
// Triggers V1 (vedi createMessageAndNotify in src/lib/messaging/create-message.ts
// + POST /api/admin/notifications/broadcast):
//   • chat_reply     — automatico, fired dopo ogni Message.create
//   • new_lesson     — manuale admin (broadcast a utenti prodotto)
//   • new_course     — manuale admin
//   • lesson_update  — manuale admin
//   • course_update  — manuale admin
//   • system_admin   — manuale admin (annuncio globale)
//   • community_reply— riservato V2 (richiede CommunityTopic/Post schema)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  entityId  String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── NotificationPreference ───────────────────────────────────────────
// Una riga per User (PK = userId). Default all-true per fare
// "Just Works" out of the box: nuovo utente → campanella subito attiva.
// getOrCreatePreference upsert se mancante (idempotente).
model NotificationPreference {
  userId              String   @id
  emailNewLesson      Boolean  @default(true)
  emailCommunityReply Boolean  @default(true)
  inappChatReply      Boolean  @default(true)
  inappNewLesson      Boolean  @default(true)
  inappCommunityReply Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Progresso Lezioni ──
// NB: do NOT add `onDelete: Cascade` on the `lesson` FK — Prisma default
//     (NoAction) matches the V1 baseline (commit 3770bb85).
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastWatchedAt DateTime? // ultima visualizzazione lezione

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@index([lessonId])
}

// ─── Appunti Studenti ──────────────────────────────────────
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── Asset Scaricabili (PDF, audio, ecc.) ──────────────────
model LessonAsset {
  id        String   @id @default(cuid())
  lessonId  String
  type      String // pdf | audio | resource
  locale    String   @default("it") // lingua dell'asset
  fileUrl   String
  fileName  String?
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── Analytics Eventi ───────────────────────────────────────
model AnalyticEvent {
  id        String   @id @default(cuid())
  sessionId String? // ID unico del visitatore (cookie-based)
  productId String?
  eventType    String // pageview | scroll_deep | click_buy | checkout_open | checkout_complete | purchase | refund | checkout_abandoned | lesson_start | lesson_complete
  channelId    String? // YouTubeChannel.id (channel attribution)
  locale       String? // "it" | "en-us" | locale seen at event time
  revenueCents Int? // signed: +amount on purchase, -amount on refund
  metadata     String? // JSON string with extra data
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  visitor VisitorSession? @relation(fields: [sessionId], references: [id])

  @@index([eventType, createdAt])
  @@index([productId])
  @@index([sessionId])
}

// ─── Sessioni Visitatore (per funnel tracking) ──────────────
model VisitorSession {
  id          String   @id @default(cuid())
  ip          String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?
  country     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  events AnalyticEvent[]
}

// ─── Cache Config (per Vercel — evita scrittura su disco) ───
model CourseConfigCache {
  id        String   @id @default(cuid())
  slug      String   @unique
  config    String // JSON string del CourseConfig completo
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Coupon / Sconti ────────────────────────────────────────
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // es. "ESTATE2026"
  type        String    @default("percent") // percent | fixed
  value       Int       // percentuale (es. 20) o importo in centesimi (es. 1000)
  minAmount   Int?      // importo minimo ordine in centesimi
  maxUses     Int?      // numero massimo di utilizzi
  usedCount   Int       @default(0)
  productId   String?   // null = applicabile a tutti i prodotti
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Tabella Locale: codici lingua-paese completi ─────────
model Locale {
  id             String   @id @default(cuid())
  code           String   @unique // "fr-fr", "pt-br", "en-us"...
  languageCode   String // "fr", "pt", "en"...
  countryCode    String? // "FR", "BR", "US"... (null per lingue senza paese es. "en")
  name           String // "French (France)"
  nativeName     String // "Français (France)"
  isActive       Boolean  @default(true)
  fallbackLocale String? // "en-us" — catena di fallback
  currency       String? // "EUR", "USD", "BRL"...
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  youtubeChannels YouTubeChannel[]
}

// ─── Regole paese → locale preferito ──────────────────────────
model CountryLocaleRule {
  id                 String   @id @default(cuid())
  countryCode        String   @unique // "FR", "DE", "BR"...
  preferredLocale    String   // "fr-fr"
  alternativeLocales String?  // JSON array: ["en-us", "de-de"]
  createdAt          DateTime @default(now())
}

// ─── Canali YouTube localizzati ───────────────────────────────
model YouTubeChannel {
  id                 String   @id @default(cuid())
  channelName        String
  channelUrl         String   @unique
  localeId           String
  locale             String // denormalizzato per query veloci: "fr-fr"
  languageCode       String // "fr"
  countryCode        String?
  niche              String?
  defaultLandingSlug String? // slug prodotto predefinito
  trackingCode       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  localeRef Locale @relation(fields: [localeId], references: [id])
}

// ─── Checkout abbandonati (per email di recupero) ─────────
model AbandonedCheckout {
  id              String    @id @default(cuid())
  email           String
  productId       String
  locale          String    @default("it")
  paymentProvider String // lemonsqueezy
  checkoutUrl     String? // URL del checkout esterno
  status          String    @default("pending") // pending | recovered | expired
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([email])
}

// ─── Traduzioni Landing Pages (DB condiviso per tutti i siti) ─
// Una tabella unica per memorizzare le traduzioni di TUTTE le landing page
// in TUTTE le lingue. Ogni sito/slug ha il suo set di traduzioni.
model LandingTranslation {
  id              String   @id @default(cuid())
  slug            String // chiave della landing (es. "amish-secrets")
  locale          String // it, en, fr, es, de, pt, ja, zh...
  // Testi della landing page
  heroTitle       String?
  heroSubtitle    String?
  heroDescription String?
  problemText     String?
  storyText       String?
  ctaText         String?
  // Sezioni strutturate (JSON)
  benefits        String? // JSON array di { title, desc }
  testimonials    String? // JSON array di { text, author }
  faq             String? // JSON array di { q, a }
  // Bonus
  bonusLabel      String?
  guaranteeText   String?
  // Metadati
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([slug, locale])
}

// ─── Conversations (una stanza per coppia + prodotto) ────────
// Phase 1.3 del piano DMs: ogni coppia (creator, cliente) ha una
// conversazione distinta per ciascun prodotto acquistato.
//   • Mario + creator: una chat per "Corso A", una per "Corso B"
//   • Il campo productId è obbligatorio: viene garantito a monte
//     dal permission resolver (Fase 1.5) e da Order conpleted.
//
// ⚠️ FK CASCADE su productId:
//   Se un Product viene eliminato, TUTTE le Conversation (e i Message
//   associati via Cascade) di quel prodotto vengono cancellati.
//   Scelta consapevole per V1: una conversazione "orfana" di prodotto
//   non ha più significato nel modello creator↔cliente↔prodotto.
//   Per "soft archive" futuro del prodotto preservando la chat,
//   valutare di migrare a ON DELETE RESTRICT + logic di archiviazione.
model Conversation {
  id        String   @id @default(cuid())
  userOneId String   // uno dei due partecipanti
  userTwoId String   // l'altro partecipante
  productId String   // prodotto che contestualizza questa DM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOne  User      @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages Message[]
  offerCards OfferCard[]

  @@unique([userOneId, userTwoId, productId])
  @@index([userOneId, updatedAt])
  @@index([userTwoId, updatedAt])
  @@index([productId, updatedAt])
}

// ─── Webhook Idempotency ──────────────────────────────────
// Previene ordini duplicati quando LemonSqueezy invia
// lo stesso webhook più di una volta.
model ProcessedWebhook {
  id         String   @id @default(cuid())
  provider   String   // lemonsqueezy
  deliveryId String   @unique // LS composite ID
  eventType  String   // checkout.session.completed, order_created, etc.
  processedAt DateTime @default(now())
  createdAt  DateTime  @default(now())
}

// ─── Direct Messages tra studente e creator ────────────────
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String   // chi ha inviato QUESTO messaggio
  content        String   @db.Text
  offerCardId    String?  // Phase 4: riferimento opaco a un'offerta commerciale
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  offerCard    OfferCard?   @relation(fields: [offerCardId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([offerCardId])
}

// ─── AccessGrant (MCR Phase 2) ─────────────────────────────────────
//
// Unified access domain: paid orders, free enrollments, admin grants,
// bundle inclusions. Replaces direct `Order.status='completed'` reads
// in `resolve-message-permission.ts` and (forward) the course portal,
// ebook downloads, lesson progress, certificates, dashboard.
//
// Migration `20260712230000_add_access_grants` creates this table
// idempotently. The resolver cutover is feature-flagged in PR 3 of MCR.
//
// Composizione della chiave unica `@@unique([sourceType, sourceId,
// productId])`:
//   - sourceType ∈ { "order", "free_enrollment", "admin", "bundle", "watchlist" }
//   - sourceId   = Order.id | enrollment_request.id | grant_audit.id | bundle.id
//   - productId  = Product.id
// La tripletà dedupa naturalmente sia i dual-write idempotenti (Order +
// backfill script) sia i multi-grant legittimi (uno per sourceType).
//
// `ON DELETE RESTRICT` su User + Product: cancellare un utente o un
// prodotto non deve far scomparire silenziosamente gli accessi.
// Richiede uno script esplicito (vedi `scripts/products/backfill-
// primary-creator.ts` per il pattern di recovery).
model AccessGrant {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  sourceType String   // "order" | "free_enrollment" | "admin" | "bundle"
  sourceId   String
  status     String   @default("active") // active | revoked | expired
  grantedAt  DateTime @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?

  user    User    @relation("UserAccessGrants", fields: [userId], references: [id], onDelete: Restrict)
  product Product @relation("ProductAccessGrants", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, productId])
  @@index([userId, productId, status])
}

// ─── Offer Cards (Phase 4 — DM upsell) ────────────────────────────────
// Offerte commerciali inviate da un creator a un destinatario in una
// conversation esistente. Lo stato segue la state machine canonica in
// src/domains/messaging/offer-card/offer-card-discriminator.ts.
// Il linkToken opaco impedisce URL commerciali liberi nei messaggi.
model OfferCard {
  id                    String   @id @default(cuid())
  creatorId             String
  recipientId           String
  conversationId        String?
  conversationProductId String
  productId             String
  status                String   @default("draft") // draft | sent | viewed | clicked | converted | expired | withdrawn
  reason                String
  currency              String
  amountCents           Int
  couponCode            String?
  couponType            String?
  couponValue           Int?
  linkToken             String   @unique
  sentAt                DateTime?
  convertedAt           DateTime?
  convertedOrderId      String?
  createdAt             DateTime @default(now())
  updatedAt               DateTime @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  creator      User         @relation("OfferCardCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  recipient    User         @relation("OfferCardRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([recipientId, createdAt])
  @@index([creatorId, productId])
}
