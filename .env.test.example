# Database di test (richiesto)
TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/test_db"

# URL dell'app in esecuzione durante i test
NEXT_PUBLIC_APP_URL="http://localhost:3000"



# LemonSqueezy (modalità test)
LEMONSQUEEZY_API_KEY="..."
LEMONSQUEEZY_STORE_ID="..."
LEMONSQUEEZY_WEBHOOK_SECRET="..."

# ID variante di test su LemonSqueezy
TEST_LEMON_VARIANT_ID="..."

# Supabase (richiesto per autenticazione nelle pagine protette)
NEXT_PUBLIC_SUPABASE_URL="https://...supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# ─── Free / Test Courses (SSOT bypass per AccessGate) ──────────────
# Slugs (separati da virgola) di prodotti con price=0 che sono accessibili
# a chiunque senza login o pagamento. Usato da AccessGate come SSOT bypass
# (vedi src/components/course/access-gate.tsx).
# In CI/dev, deve contenere "test-course-e2e" cosi i test del free course path
# funzionano anche senza Stripe/Supabase secrets.
# Esempio: FREE_COURSE_SLUGS="test-course-e2e,other-free-slug"
FREE_COURSE_SLUGS="test-course-e2e"
